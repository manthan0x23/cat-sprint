# Neon Postgres (use the pooled connection string)
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OpenRouter (free Qwen). Free accounts: 50 requests/day total.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_FALLBACKS=google/gemma-4-31b-it:free,deepseek/deepseek-v4-flash-0731:free
AI_DAILY_BUDGET=45

# Web push — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/tick (cron-job.org sends it as header x-cron-secret)
CRON_SECRET=

# Public URL, used in notification links
APP_URL=http://localhost:3000
